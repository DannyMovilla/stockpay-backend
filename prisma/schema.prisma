generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model customers {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  full_name    String         @db.VarChar(150)
  email        String         @unique @db.VarChar(150)
  phone        String         @db.VarChar(30)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  transactions transactions[]

  @@index([email], map: "idx_customers_email")
}

model deliveries {
  id             String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  address        String
  city           String          @db.VarChar(100)
  country        String          @db.VarChar(100)
  status         delivery_status @default(PENDING)
  transaction_id String          @unique @db.Uuid
  transactions   transactions    @relation(fields: [transaction_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_delivery_transaction")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name         String         @db.VarChar(150)
  description  String
  price        Decimal        @db.Decimal(12, 2)
  stock        Int
  image_url    String
  active       Boolean        @default(true)
  created_at   DateTime       @default(now()) @db.Timestamp(6)
  updated_at   DateTime       @default(now()) @db.Timestamp(6)
  transactions transactions[]

  @@index([active], map: "idx_products_active")
  @@index([stock], map: "idx_products_stock")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model transactions {
  id                   String             @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  status               transaction_status
  amount               Decimal            @db.Decimal(12, 2)
  base_fee             Decimal            @db.Decimal(12, 2)
  shipping_fee         Decimal            @db.Decimal(12, 2)
  total_amount         Decimal            @db.Decimal(12, 2)
  quantity             Int                @default(1)
  wompi_transaction_id String?            @db.VarChar(100)
  product_id           String             @db.Uuid
  customer_id          String             @db.Uuid
  created_at           DateTime           @default(now()) @db.Timestamp(6)
  updated_at           DateTime           @default(now()) @db.Timestamp(6)
  deliveries           deliveries?
  customers            customers          @relation(fields: [customer_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_customer")
  products             products           @relation(fields: [product_id], references: [id], onDelete: NoAction, onUpdate: NoAction, map: "fk_transaction_product")

  @@index([customer_id], map: "idx_transactions_customer")
  @@index([product_id], map: "idx_transactions_product")
  @@index([status], map: "idx_transactions_status")
}

enum delivery_status {
  PENDING
  ASSIGNED
  DELIVERED
}

enum transaction_status {
  PENDING
  APPROVED
  FAILED
}
